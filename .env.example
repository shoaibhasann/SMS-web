NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Guardian phone OTP stays unavailable until funded delivery is configured.
# Never put the keys below in NEXT_PUBLIC_ variables (the Turnstile site key is public).
GUARDIAN_PHONE_AUTH_ENABLED=false
GUARDIAN_PHONE_AUTH_ORIGIN=https://sms-web-shoaibhasann.vercel.app
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SMS_HOOK_SECRET=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Explicit billed-attempt limits, not successful-login or delivery counts.
GUARDIAN_SMS_GLOBAL_DAILY_LIMIT=500
GUARDIAN_SMS_SCHOOL_DAILY_LIMIT=500
GUARDIAN_SMS_PHONE_DAILY_LIMIT=5

# Enable only after the admin eligibility migration, SMTP, and the Magic Link code template are ready.
# Requires the server-only SUPABASE_SERVICE_ROLE_KEY above.
NEXT_PUBLIC_ADMIN_EMAIL_OTP_ENABLED=false
ADMIN_EMAIL_OTP_ORIGIN=https://sms-web-shoaibhasann.vercel.app

# Native-app push backend. Leave OFF until the native app, FCM and scheduler are verified.
# These values are server-only. Use a dedicated FCM sender account with least privilege.
NATIVE_PUSH_ENABLED=false
PUSH_DISPATCH_SECRET=
CRON_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
